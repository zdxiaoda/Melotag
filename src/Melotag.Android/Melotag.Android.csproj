<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>Melotag.Droid</RootNamespace>
    <AssemblyName>Melotag.Android</AssemblyName>
    <Product>音签 Melotag</Product>
    <ApplicationId>io.melotag.app</ApplicationId>
    <ApplicationVersion>8</ApplicationVersion>
    <!-- 显示版本继承 Directory.Build.props 的 Version，避免与桌面端不一致。 -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Melotag.UI\Melotag.UI.csproj" />
  </ItemGroup>
</Project>
