<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Melotag.Desktop</RootNamespace>
    <AssemblyName>Melotag</AssemblyName>
    <Product>音签 Melotag</Product>
    <AssemblyTitle>音签 Melotag</AssemblyTitle>
    <Description>跨平台音乐标签编辑器</Description>
    <Company>Melotag</Company>
    <!-- 版本号继承 Directory.Build.props 的 Version；发布流水线可 -p:Version 覆盖。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Melotag.UI\Assets\Melotag.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Melotag.UI\Melotag.UI.csproj" />
  </ItemGroup>
</Project>
