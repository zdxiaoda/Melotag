<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Melotag.UI.Views.MainWindow"
        Title="音签 Melotag · 标签编辑器"
        Icon="avares://Melotag.UI/Assets/melotag-logo.png"
        Width="1360" Height="760"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Melotag.UI/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSelectedCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- 工具栏图标按钮：24×24 描边几何，颜色跟随主题正文色 -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled Path">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.toolbarSeparator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="7,0" />
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Menu Grid.Row="0">
      <MenuItem Header="文件">
        <MenuItem Header="添加文件…" Click="OnAddFiles" />
        <MenuItem Header="添加文件夹…" Click="OnAddFolder" />
        <Separator />
        <MenuItem Header="保存当前标签" Command="{Binding SaveSelectedCommand}" />
        <MenuItem Header="保存全部" Click="OnSaveAll" />
        <Separator />
        <MenuItem Header="退出" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="编辑">
        <MenuItem Header="重新读取" Command="{Binding ReloadCommand}" />
        <MenuItem Header="从列表移除" Command="{Binding RemoveSelectedCommand}" />
        <MenuItem Header="清空标签（内存）" Click="OnClearTags" />
      </MenuItem>
      <MenuItem Header="工具">
        <MenuItem Header="重命名 / 文件名相关…" Click="OnRename" />
        <MenuItem Header="在线标签匹配…" Click="OnTagSearch" />
        <MenuItem Header="歌词…" Click="OnLyrics" />
        <MenuItem Header="封面…" Click="OnCover" />
        <MenuItem Header="标签历史…" Click="OnHistory" />
        <Separator />
        <MenuItem Header="标签简→繁" Click="OnTagsToTraditional" />
        <MenuItem Header="标签繁→简" Click="OnTagsToSimplified" />
        <MenuItem Header="文件名简→繁" Click="OnNamesToTraditional" />
        <MenuItem Header="文件名繁→简" Click="OnNamesToSimplified" />
        <Separator />
        <MenuItem Header="设置…" Click="OnSettings" />
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="切换深色 / 浅色" Click="OnToggleTheme" />
      </MenuItem>
      <MenuItem Header="帮助">
        <MenuItem Header="关于" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Padding="10,7"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
          <Image Source="avares://Melotag.UI/Assets/melotag-logo.png" Width="26" Height="26"
                 Margin="2,0,10,0" VerticalAlignment="Center" />

          <Button Classes="icon" Click="OnAddFiles"
                  ToolTip.Tip="添加文件" AutomationProperties.Name="添加文件">
            <Path Classes="icon" Data="{StaticResource IconAddFile}" />
          </Button>
          <Button Classes="icon" Click="OnAddFolder"
                  ToolTip.Tip="添加文件夹（含子目录）" AutomationProperties.Name="添加文件夹">
            <Path Classes="icon" Data="{StaticResource IconAddFolder}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Command="{Binding ReloadCommand}"
                  ToolTip.Tip="重新读取（F5）" AutomationProperties.Name="重新读取">
            <Path Classes="icon" Data="{StaticResource IconReload}" />
          </Button>
          <Button Classes="icon" Command="{Binding SaveSelectedCommand}"
                  ToolTip.Tip="保存当前标签（Ctrl+S）" AutomationProperties.Name="保存当前标签">
            <Path Classes="icon" Data="{StaticResource IconSave}" />
          </Button>
          <Button Classes="icon" Click="OnSaveAll"
                  ToolTip.Tip="保存全部" AutomationProperties.Name="保存全部">
            <Path Classes="icon" Data="{StaticResource IconSaveAll}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Command="{Binding RemoveSelectedCommand}"
                  ToolTip.Tip="从列表移除" AutomationProperties.Name="从列表移除">
            <Path Classes="icon" Data="{StaticResource IconRemove}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnRename"
                  ToolTip.Tip="重命名 / 文件名相关…" AutomationProperties.Name="重命名">
            <Path Classes="icon" Data="{StaticResource IconRename}" />
          </Button>
          <Button Classes="icon" Click="OnTagSearch"
                  ToolTip.Tip="在线标签匹配…" AutomationProperties.Name="在线标签匹配">
            <Path Classes="icon" Data="{StaticResource IconOnline}" />
          </Button>
          <Button Classes="icon" Click="OnAutoMatch"
                  ToolTip.Tip="批量自动匹配" AutomationProperties.Name="批量自动匹配">
            <Path Classes="icon" Data="{StaticResource IconAutoMatch}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnLyrics"
                  ToolTip.Tip="歌词…" AutomationProperties.Name="歌词">
            <Path Classes="icon" Data="{StaticResource IconLyrics}" />
          </Button>
          <Button Classes="icon" Click="OnCover"
                  ToolTip.Tip="封面…" AutomationProperties.Name="封面">
            <Path Classes="icon" Data="{StaticResource IconCover}" />
          </Button>
          <Button Classes="icon" Click="OnExtractCovers"
                  ToolTip.Tip="批量提取封面" AutomationProperties.Name="批量提取封面">
            <Path Classes="icon" Data="{StaticResource IconExtractCover}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnHistory"
                  ToolTip.Tip="标签历史…" AutomationProperties.Name="标签历史">
            <Path Classes="icon" Data="{StaticResource IconHistory}" />
          </Button>
          <Button Classes="icon" Click="OnClearTags"
                  ToolTip.Tip="清空标签（仅在内存中）" AutomationProperties.Name="清空标签">
            <Path Classes="icon" Data="{StaticResource IconClear}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnSettings"
                  ToolTip.Tip="设置…" AutomationProperties.Name="设置">
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
          </Button>
          <Button Classes="icon" Click="OnToggleTheme"
                  ToolTip.Tip="切换深色 / 浅色主题" AutomationProperties.Name="切换主题">
            <Path Classes="icon" Data="{StaticResource IconTheme}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IconSearch}" Width="18" Height="18" Opacity="0.5" />
          <TextBox x:Name="FilterBox" Width="250"
                   PlaceholderText="过滤：文件名 / 标题 / 艺术家 / 专辑"
                   TextChanged="OnFilterChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,360">
      <DataGrid x:Name="TracksGrid"
                Grid.Column="0"
                ItemsSource="{Binding Tracks}"
                SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                RowHeight="32"
                Margin="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="190" MinWidth="120" />
          <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" MinWidth="120" />
          <DataGridTextColumn Header="艺术家" Binding="{Binding Artist}" Width="1.5*" MinWidth="100" />
          <DataGridTextColumn Header="专辑" Binding="{Binding Album}" Width="1.5*" MinWidth="100" />
          <DataGridTextColumn Header="年份" Binding="{Binding YearText}" Width="76" />
          <DataGridTextColumn Header="音轨" Binding="{Binding TrackText}" Width="76" />
          <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="80" />
          <DataGridTextColumn Header="格式" Binding="{Binding FormatText}" Width="100" />
          <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="88" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1"
              BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <ScrollViewer>
          <StackPanel Margin="14" Spacing="10"
                      IsEnabled="{Binding SelectedTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="标签编辑" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedTrack.Path}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

            <Border Height="150" CornerRadius="4" Padding="6"
                    Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
              <Image Source="{Binding SelectedTrack.CoverPreview}" Stretch="Uniform" />
            </Border>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="标题" />
              <TextBox Text="{Binding SelectedTrack.Title, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="艺术家" />
              <TextBox Text="{Binding SelectedTrack.Artist, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="专辑" />
              <TextBox Text="{Binding SelectedTrack.Album, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="专辑艺术家" />
              <TextBox Text="{Binding SelectedTrack.AlbumArtist, Mode=TwoWay}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Classes="field">
                <TextBlock Classes="fieldLabel" Text="年份" />
                <TextBox Text="{Binding SelectedTrack.YearText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Classes="field">
                <TextBlock Classes="fieldLabel" Text="音轨" />
                <TextBox Text="{Binding SelectedTrack.TrackText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Classes="field">
                <TextBlock Classes="fieldLabel" Text="碟号" />
                <TextBox Text="{Binding SelectedTrack.DiscText, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="流派" />
              <TextBox Text="{Binding SelectedTrack.Genre, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="作曲" />
              <TextBox Text="{Binding SelectedTrack.Composer, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="注释" />
              <TextBox Text="{Binding SelectedTrack.Comment, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="歌词" />
              <TextBox Text="{Binding SelectedTrack.Lyrics, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       Height="150" VerticalContentAlignment="Top" />
            </StackPanel>

            <TextBlock Text="{Binding SelectedTrack.ErrorText}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="3" Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding CountText}" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="16,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="avares://Melotag.UI/Assets/melotag-logo.png" Width="14" Height="14"
                 VerticalAlignment="Center" />
          <TextBlock Text="音签 1.0.0 · TagLib#" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
