<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Melotag.UI.Localization"
        x:Class="Melotag.UI.Views.MainWindow"
        Title="{loc:Tr Key=App.WindowTitle}"
        Icon="avares://Melotag.UI/Assets/melotag-logo.png"
        Width="1360" Height="760"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Melotag.UI/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSelectedCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- 工具栏图标按钮：24×24 描边几何，颜色跟随主题正文色 -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled Path">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.toolbarSeparator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="7,0" />
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Menu Grid.Row="0">
      <MenuItem Header="{loc:Tr Key=Menu.File}">
        <MenuItem Header="{loc:Tr Key=Menu.File.AddFiles}" Click="OnAddFiles" />
        <MenuItem Header="{loc:Tr Key=Menu.File.AddFolder}" Click="OnAddFolder" />
        <Separator />
        <MenuItem Header="{loc:Tr Key=Menu.File.SaveCurrent}" Command="{Binding SaveSelectedCommand}" />
        <MenuItem Header="{loc:Tr Key=Menu.File.SaveAll}" Click="OnSaveAll" />
        <Separator />
        <MenuItem Header="{loc:Tr Key=Menu.File.Exit}" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="{loc:Tr Key=Menu.Edit}">
        <MenuItem Header="{loc:Tr Key=Menu.Edit.Reload}" Command="{Binding ReloadCommand}" />
        <MenuItem Header="{loc:Tr Key=Menu.Edit.Remove}" Command="{Binding RemoveSelectedCommand}" />
        <MenuItem Header="{loc:Tr Key=Menu.Edit.ClearTags}" Click="OnClearTags" />
      </MenuItem>
      <MenuItem Header="{loc:Tr Key=Menu.Tools}">
        <MenuItem Header="{loc:Tr Key=Menu.Tools.Rename}" Click="OnRename" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.TagSearch}" Click="OnTagSearch" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.Lyrics}" Click="OnLyrics" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.Cover}" Click="OnCover" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.History}" Click="OnHistory" />
        <Separator />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.TagsToTraditional}" Click="OnTagsToTraditional" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.TagsToSimplified}" Click="OnTagsToSimplified" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.NamesToTraditional}" Click="OnNamesToTraditional" />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.NamesToSimplified}" Click="OnNamesToSimplified" />
        <Separator />
        <MenuItem Header="{loc:Tr Key=Menu.Tools.Settings}" Click="OnSettings" />
      </MenuItem>
      <MenuItem Header="{loc:Tr Key=Menu.View}">
        <MenuItem Header="{loc:Tr Key=Menu.View.ToggleTheme}" Click="OnToggleTheme" />
      </MenuItem>
      <MenuItem Header="{loc:Tr Key=Menu.Help}">
        <MenuItem Header="{loc:Tr Key=Menu.Help.CheckUpdates}" Click="OnCheckUpdates" />
        <MenuItem Header="{loc:Tr Key=Menu.Help.About}" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Padding="10,7"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
          <Image Source="avares://Melotag.UI/Assets/melotag-logo.png" Width="26" Height="26"
                 Margin="2,0,10,0" VerticalAlignment="Center" />

          <Button Classes="icon" Click="OnAddFiles"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.AddFile}" AutomationProperties.Name="{loc:Tr Key=Toolbar.AddFile}">
            <Path Classes="icon" Data="{StaticResource IconAddFile}" />
          </Button>
          <Button Classes="icon" Click="OnAddFolder"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.AddFolder}" AutomationProperties.Name="{loc:Tr Key=Toolbar.AddFolder}">
            <Path Classes="icon" Data="{StaticResource IconAddFolder}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Command="{Binding ReloadCommand}"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Reload}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Reload}">
            <Path Classes="icon" Data="{StaticResource IconReload}" />
          </Button>
          <Button Classes="icon" Command="{Binding SaveSelectedCommand}"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.SaveCurrent}" AutomationProperties.Name="{loc:Tr Key=Toolbar.SaveCurrent}">
            <Path Classes="icon" Data="{StaticResource IconSave}" />
          </Button>
          <Button Classes="icon" Click="OnSaveAll"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.SaveAll}" AutomationProperties.Name="{loc:Tr Key=Toolbar.SaveAll}">
            <Path Classes="icon" Data="{StaticResource IconSaveAll}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Command="{Binding RemoveSelectedCommand}"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Remove}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Remove}">
            <Path Classes="icon" Data="{StaticResource IconRemove}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnRename"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Rename}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Rename}">
            <Path Classes="icon" Data="{StaticResource IconRename}" />
          </Button>
          <Button Classes="icon" Click="OnTagSearch"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.TagSearch}" AutomationProperties.Name="{loc:Tr Key=Toolbar.TagSearch}">
            <Path Classes="icon" Data="{StaticResource IconOnline}" />
          </Button>
          <Button Classes="icon" Click="OnAutoMatch"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.AutoMatch}" AutomationProperties.Name="{loc:Tr Key=Toolbar.AutoMatch}">
            <Path Classes="icon" Data="{StaticResource IconAutoMatch}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnLyrics"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Lyrics}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Lyrics}">
            <Path Classes="icon" Data="{StaticResource IconLyrics}" />
          </Button>
          <Button Classes="icon" Click="OnCover"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Cover}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Cover}">
            <Path Classes="icon" Data="{StaticResource IconCover}" />
          </Button>
          <Button Classes="icon" Click="OnExtractCovers"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.ExtractCovers}" AutomationProperties.Name="{loc:Tr Key=Toolbar.ExtractCovers}">
            <Path Classes="icon" Data="{StaticResource IconExtractCover}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnHistory"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.History}" AutomationProperties.Name="{loc:Tr Key=Toolbar.History}">
            <Path Classes="icon" Data="{StaticResource IconHistory}" />
          </Button>
          <Button Classes="icon" Click="OnClearTags"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.ClearTags}" AutomationProperties.Name="{loc:Tr Key=Toolbar.ClearTags}">
            <Path Classes="icon" Data="{StaticResource IconClear}" />
          </Button>

          <Border Classes="toolbarSeparator" />

          <Button Classes="icon" Click="OnSettings"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.Settings}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Settings}">
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
          </Button>
          <Button Classes="icon" Click="OnToggleTheme"
                  ToolTip.Tip="{loc:Tr Key=Toolbar.ToggleTheme}" AutomationProperties.Name="{loc:Tr Key=Toolbar.ToggleThemeName}">
            <Path Classes="icon" Data="{StaticResource IconTheme}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IconSearch}" Width="18" Height="18" Opacity="0.5" />
          <TextBox x:Name="FilterBox" Width="250"
                   PlaceholderText="{loc:Tr Key=Filter.Placeholder}"
                   TextChanged="OnFilterChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,360">
      <DataGrid x:Name="TracksGrid"
                Grid.Column="0"
                ItemsSource="{Binding Tracks}"
                SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                SelectionMode="Extended"
                KeyDown="OnTracksKeyDown"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                RowHeight="32"
                Margin="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Tr Key=Column.FileName}" Binding="{Binding FileName}" Width="190" MinWidth="120" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Title}" Binding="{Binding Title}" Width="2*" MinWidth="120" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Artist}" Binding="{Binding Artist}" Width="1.5*" MinWidth="100" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Album}" Binding="{Binding Album}" Width="1.5*" MinWidth="100" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Year}" Binding="{Binding YearText}" SortMemberPath="YearNumber" Width="76" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Track}" Binding="{Binding TrackText}" SortMemberPath="TrackNumber" Width="76" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Duration}" Binding="{Binding DurationText}" SortMemberPath="DurationSeconds" Width="80" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Format}" Binding="{Binding FormatText}" Width="100" />
          <DataGridTextColumn Header="{loc:Tr Key=Column.Status}" Binding="{Binding StatusText}" Width="88" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1"
              BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <ScrollViewer>
          <StackPanel Margin="14" Spacing="10"
                      IsEnabled="{Binding SelectedTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{loc:Tr Key=Editor.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedTrack.Path}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

            <Border Height="150" CornerRadius="4" Padding="6"
                    Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
              <Image Source="{Binding SelectedTrack.CoverPreview}" Stretch="Uniform" />
            </Border>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.TitleLabel}" />
              <TextBox Text="{Binding SelectedTrack.Title, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.ArtistLabel}" />
              <TextBox Text="{Binding SelectedTrack.Artist, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.AlbumLabel}" />
              <TextBox Text="{Binding SelectedTrack.Album, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.AlbumArtistLabel}" />
              <TextBox Text="{Binding SelectedTrack.AlbumArtist, Mode=TwoWay}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Classes="field">
                <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.YearLabel}" />
                <TextBox Text="{Binding SelectedTrack.YearText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Classes="field">
                <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.TrackLabel}" />
                <TextBox Text="{Binding SelectedTrack.TrackText, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Classes="field">
                <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.DiscLabel}" />
                <TextBox Text="{Binding SelectedTrack.DiscText, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.GenreLabel}" />
              <TextBox Text="{Binding SelectedTrack.Genre, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.ComposerLabel}" />
              <TextBox Text="{Binding SelectedTrack.Composer, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.CommentLabel}" />
              <TextBox Text="{Binding SelectedTrack.Comment, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Classes="field">
              <TextBlock Classes="fieldLabel" Text="{Binding SelectedTrack.LyricsLabel}" />
              <TextBox Text="{Binding SelectedTrack.Lyrics, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       Height="150" VerticalContentAlignment="Top" />
            </StackPanel>

            <TextBlock Text="{Binding SelectedTrack.ErrorText}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="3" Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding CountText}" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="16,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="avares://Melotag.UI/Assets/melotag-logo.png" Width="14" Height="14"
                 VerticalAlignment="Center" />
          <TextBlock Text="{Binding AppVersionText}" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
