<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Melotag.UI.Localization"
             x:Class="Melotag.UI.Views.MobileShellView"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Melotag.UI/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon Path">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 顶栏 -->
    <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Image Grid.Column="0" Source="avares://Melotag.UI/Assets/melotag-logo.png"
               Width="28" Height="28" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{loc:Tr Key=App.Name}" FontSize="16" FontWeight="SemiBold"
                   Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="2" Classes="icon" Click="OnAddFiles"
                ToolTip.Tip="{loc:Tr Key=Toolbar.AddFile}" AutomationProperties.Name="{loc:Tr Key=Toolbar.AddFile}">
          <Path Data="{StaticResource IconAddFile}" />
        </Button>
        <Button Grid.Column="3" Classes="icon" Click="OnAddFolder"
                ToolTip.Tip="{loc:Tr Key=Toolbar.AddFolder}" AutomationProperties.Name="{loc:Tr Key=Toolbar.AddFolder}">
          <Path Data="{StaticResource IconAddFolder}" />
        </Button>
        <Button Grid.Column="4" Classes="icon" Command="{Binding SaveSelectedCommand}"
                ToolTip.Tip="{loc:Tr Key=Toolbar.SaveCurrent}" AutomationProperties.Name="{loc:Tr Key=Toolbar.SaveCurrent}">
          <Path Data="{StaticResource IconSave}" />
        </Button>
        <Button Grid.Column="5" Classes="icon" AutomationProperties.Name="{loc:Tr Key=Toolbar.More}">
          <Path Data="{StaticResource IconSettings}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Tr Key=Menu.File.AddFolder}" Click="OnAddFolder" />
              <MenuItem Header="{loc:Tr Key=Menu.Edit.Reload}" Click="OnReload" />
              <MenuItem Header="{loc:Tr Key=Menu.File.SaveAll}" Click="OnSaveAll" />
              <Separator />
              <MenuItem Header="{loc:Tr Key=Toolbar.AutoMatch}" Click="OnAutoMatch" />
              <MenuItem Header="{loc:Tr Key=Toolbar.ExtractCovers}" Click="OnExtractCovers" />
              <Separator />
              <MenuItem Header="{loc:Tr Key=Menu.Tools.TagsToTraditional}" Click="OnTagsToTraditional" />
              <MenuItem Header="{loc:Tr Key=Menu.Tools.TagsToSimplified}" Click="OnTagsToSimplified" />
              <MenuItem Header="{loc:Tr Key=Menu.Tools.Rename}" Click="OnRename" />
              <Separator />
              <MenuItem Header="{loc:Tr Key=Menu.Tools.Settings}" Click="OnSettings" />
              <MenuItem Header="{loc:Tr Key=Menu.View.ToggleTheme}" Click="OnToggleTheme" />
              <MenuItem Header="{loc:Tr Key=Menu.Help.CheckUpdates}" Click="OnCheckUpdates" />
              <MenuItem Header="{loc:Tr Key=Menu.Help.About}" Click="OnAbout" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- 过滤 + 排序 -->
    <Grid Grid.Row="1" Margin="12,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" x:Name="FilterBox" PlaceholderText="{loc:Tr Key=Filter.Placeholder}"
               TextChanged="OnFilterChanged" />
      <Button Grid.Column="1" Classes="icon" AutomationProperties.Name="{loc:Tr Key=Sort.Title}"
              ToolTip.Tip="{loc:Tr Key=Sort.Title}">
        <TextBlock Text="⇅" FontSize="18" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" Opened="OnSortFlyoutOpened">
            <StackPanel Width="220" Spacing="8" Margin="4">
              <TextBlock Text="{loc:Tr Key=Sort.Title}" FontWeight="SemiBold" />
              <ListBox x:Name="SortFieldList" MaxHeight="260" SelectionChanged="OnSortFieldChanged" />
              <CheckBox x:Name="SortDescendingBox" Content="{loc:Tr Key=Sort.Descending}"
                        IsCheckedChanged="OnSortDescendingChanged" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- 列表页 -->
    <Grid Grid.Row="2" x:Name="ListPage">
      <ListBox x:Name="TrackList"
               ItemsSource="{Binding Tracks}"
               SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
               SelectionChanged="OnSelectionChanged"
               Tapped="OnRowTapped"
               Margin="4,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,3">
              <Border Width="46" Height="46" CornerRadius="6" ClipToBounds="True"
                      Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
                <Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Artist}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Album}" />
                </TextBlock>
                <TextBlock FontSize="11" Opacity="0.55">
                  <Run Text="{Binding StatusText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding DurationText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding FormatText}" />
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}"
                      Width="40" Height="40" Padding="0" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" CornerRadius="8"
                      ToolTip.Tip="{loc:Tr Key=Toolbar.Remove}" AutomationProperties.Name="{loc:Tr Key=Toolbar.Remove}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyHint"
                 Text="{loc:Tr Key=Mobile.EmptyHint}"
                 Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" />
    </Grid>

    <!-- 详情页 -->
    <Grid Grid.Row="2" x:Name="DetailPage" IsVisible="False" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Padding="6,2" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Classes="icon" Click="OnBack" AutomationProperties.Name="{loc:Tr Key=Mobile.Back}">
            <TextBlock Text="←" FontSize="20" />
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.FileName}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Content="{loc:Tr Key=Button.Save}" Click="OnSaveSelected" Classes="accent" Margin="0,0,6,0" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="12" Spacing="10">

          <Border Height="140" CornerRadius="6" Padding="6"
                  Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
            <Image Source="{Binding SelectedTrack.CoverPreview}" Stretch="Uniform" />
          </Border>

          <WrapPanel>
            <Button Content="{loc:Tr Key=Mobile.OnlineMatch}" Click="OnTagSearch" Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key=Toolbar.Lyrics}" Click="OnLyrics" Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key=Toolbar.Cover}" Click="OnCover" Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key=Mobile.History}" Click="OnHistory" Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key=Mobile.ClearTags}" Click="OnClearTags" Margin="0,0,8,8" />
            <Button Content="{loc:Tr Key=Mobile.RemoveFromList}" Click="OnRemoveSelected" Margin="0,0,8,8" />
          </WrapPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.TitleLabel}" />
            <TextBox Text="{Binding SelectedTrack.Title, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.ArtistLabel}" />
            <TextBox Text="{Binding SelectedTrack.Artist, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.AlbumLabel}" />
            <TextBox Text="{Binding SelectedTrack.Album, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.AlbumArtistLabel}" />
            <TextBox Text="{Binding SelectedTrack.AlbumArtist, Mode=TwoWay}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="label" Text="{Binding SelectedTrack.YearLabel}" />
              <TextBox Text="{Binding SelectedTrack.YearText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="label" Text="{Binding SelectedTrack.TrackLabel}" />
              <TextBox Text="{Binding SelectedTrack.TrackText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="{Binding SelectedTrack.DiscLabel}" />
              <TextBox Text="{Binding SelectedTrack.DiscText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.GenreLabel}" />
            <TextBox Text="{Binding SelectedTrack.Genre, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.ComposerLabel}" />
            <TextBox Text="{Binding SelectedTrack.Composer, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.CommentLabel}" />
            <TextBox Text="{Binding SelectedTrack.Comment, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding SelectedTrack.LyricsLabel}" />
            <TextBox Text="{Binding SelectedTrack.Lyrics, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="160" VerticalContentAlignment="Top" />
          </StackPanel>

          <TextBlock Text="{Binding SelectedTrack.ErrorText}"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedTrack.Path}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="3" Padding="12,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding CountText}" Opacity="0.8" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Content="{loc:Tr Key=Button.Cancel}" Command="{Binding CancelLoadCommand}"
                IsVisible="{Binding IsLoading}" Padding="8,0" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
