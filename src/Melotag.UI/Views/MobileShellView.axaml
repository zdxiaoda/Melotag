<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melotag.UI.Views.MobileShellView"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Melotag.UI/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon Path">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 顶栏 -->
    <Border Grid.Row="0" Padding="10,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Image Grid.Column="0" Source="avares://Melotag.UI/Assets/melotag-logo.png"
               Width="28" Height="28" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="音签 Melotag" FontSize="16" FontWeight="SemiBold"
                   Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="2" Classes="icon" Click="OnAddFiles"
                ToolTip.Tip="添加文件" AutomationProperties.Name="添加文件">
          <Path Data="{StaticResource IconAddFile}" />
        </Button>
        <Button Grid.Column="3" Classes="icon" Command="{Binding SaveSelectedCommand}"
                ToolTip.Tip="保存当前标签" AutomationProperties.Name="保存当前标签">
          <Path Data="{StaticResource IconSave}" />
        </Button>
        <Button Grid.Column="4" Classes="icon" AutomationProperties.Name="更多">
          <Path Data="{StaticResource IconSettings}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="添加文件夹…" Click="OnAddFolder" />
              <MenuItem Header="重新读取" Click="OnReload" />
              <MenuItem Header="保存全部" Click="OnSaveAll" />
              <Separator />
              <MenuItem Header="批量自动匹配" Click="OnAutoMatch" />
              <MenuItem Header="批量提取封面" Click="OnExtractCovers" />
              <Separator />
              <MenuItem Header="标签简→繁" Click="OnTagsToTraditional" />
              <MenuItem Header="标签繁→简" Click="OnTagsToSimplified" />
              <MenuItem Header="重命名 / 文件名…" Click="OnRename" />
              <Separator />
              <MenuItem Header="设置…" Click="OnSettings" />
              <MenuItem Header="切换深色 / 浅色" Click="OnToggleTheme" />
              <MenuItem Header="关于" Click="OnAbout" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- 过滤 -->
    <TextBox Grid.Row="1" x:Name="FilterBox" Margin="12,8" Watermark="过滤：文件名 / 标题 / 艺术家 / 专辑"
             TextChanged="OnFilterChanged" />

    <!-- 列表页 -->
    <Grid Grid.Row="2" x:Name="ListPage">
      <ListBox x:Name="TrackList"
               ItemsSource="{Binding Tracks}"
               SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
               SelectionChanged="OnSelectionChanged"
               Tapped="OnRowTapped"
               Margin="4,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,3">
              <Border Width="46" Height="46" CornerRadius="6" ClipToBounds="True"
                      Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
                <Image Source="{Binding CoverPreview}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Artist}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Album}" />
                </TextBlock>
                <TextBlock FontSize="11" Opacity="0.55">
                  <Run Text="{Binding StatusText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding DurationText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding FormatText}" />
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}"
                      Width="40" Height="40" Padding="0" VerticalAlignment="Center"
                      Background="Transparent" BorderThickness="0" CornerRadius="8"
                      ToolTip.Tip="从列表移除" AutomationProperties.Name="从列表移除" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyHint"
                 Text="点右上角 + 添加音频文件（SAF 选择后复制到应用内编辑）"
                 Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" />
    </Grid>

    <!-- 详情页 -->
    <Grid Grid.Row="2" x:Name="DetailPage" IsVisible="False" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Padding="6,2" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Classes="icon" Click="OnBack" AutomationProperties.Name="返回">
            <TextBlock Text="←" FontSize="20" />
          </Button>
          <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.FileName}" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Content="保存" Click="OnSaveSelected" Classes="accent" Margin="0,0,6,0" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="12" Spacing="10">

          <Border Height="140" CornerRadius="6" Padding="6"
                  Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}">
            <Image Source="{Binding SelectedTrack.CoverPreview}" Stretch="Uniform" />
          </Border>

          <WrapPanel>
            <Button Content="在线匹配" Click="OnTagSearch" Margin="0,0,8,8" />
            <Button Content="歌词" Click="OnLyrics" Margin="0,0,8,8" />
            <Button Content="封面" Click="OnCover" Margin="0,0,8,8" />
            <Button Content="历史" Click="OnHistory" Margin="0,0,8,8" />
            <Button Content="清空标签" Click="OnClearTags" Margin="0,0,8,8" />
            <Button Content="移出列表" Click="OnRemoveSelected" Margin="0,0,8,8" />
          </WrapPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="标题" />
            <TextBox Text="{Binding SelectedTrack.Title, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="艺术家" />
            <TextBox Text="{Binding SelectedTrack.Artist, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="专辑" />
            <TextBox Text="{Binding SelectedTrack.Album, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="专辑艺术家" />
            <TextBox Text="{Binding SelectedTrack.AlbumArtist, Mode=TwoWay}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="label" Text="年份" />
              <TextBox Text="{Binding SelectedTrack.YearText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="label" Text="音轨" />
              <TextBox Text="{Binding SelectedTrack.TrackText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="碟号" />
              <TextBox Text="{Binding SelectedTrack.DiscText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="流派" />
            <TextBox Text="{Binding SelectedTrack.Genre, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="作曲" />
            <TextBox Text="{Binding SelectedTrack.Composer, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="注释" />
            <TextBox Text="{Binding SelectedTrack.Comment, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="歌词" />
            <TextBox Text="{Binding SelectedTrack.Lyrics, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Height="160" VerticalContentAlignment="Top" />
          </StackPanel>

          <TextBlock Text="{Binding SelectedTrack.ErrorText}"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedTrack.Path}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="3" Padding="12,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding CountText}" Opacity="0.8" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
