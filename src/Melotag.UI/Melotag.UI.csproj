<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Melotag.UI</RootNamespace>
    <!-- DataGrid 列模板难以逐列声明 x:DataType，先使用反射绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Melotag.Core\Melotag.Core.csproj" />
    <ProjectReference Include="..\Melotag.Tags\Melotag.Tags.csproj" />
    <ProjectReference Include="..\Melotag.Storage\Melotag.Storage.csproj" />
  </ItemGroup>
</Project>
