<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Melotag.UI.Localization"
             x:Class="Melotag.UI.Controls.SourceOrderPanel">

  <Grid RowDefinitions="*,Auto" RowSpacing="6">
    <Border Grid.Row="0"
            BorderThickness="1" CornerRadius="6"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <ScrollViewer MaxHeight="272" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="SourcesList" Margin="6,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,1">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CapabilityText}" Width="112" TextAlignment="Right"
                           FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="↑" Width="26" Height="24" Padding="0"
                        FontSize="12" HorizontalContentAlignment="Center"
                        Click="OnMoveUp" ToolTip.Tip="{loc:Tr Key=Button.MoveUp}" AutomationProperties.Name="{loc:Tr Key=Button.MoveUp}" />
                <Button Grid.Column="4" Content="↓" Width="26" Height="24" Padding="0"
                        FontSize="12" HorizontalContentAlignment="Center"
                        Click="OnMoveDown" ToolTip.Tip="{loc:Tr Key=Button.MoveDown}" AutomationProperties.Name="{loc:Tr Key=Button.MoveDown}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
      <Button Content="{loc:Tr Key=Button.ResetDefault}" FontSize="12" Padding="10,4" Click="OnReset" />
      <TextBlock Text="{loc:Tr Key=SourceOrder.Hint}"
                 FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
