<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Melotag.UI.Localization"
              x:Class="Melotag.UI.Dialogs.ExitConfirmDialog">

  <UserControl.Styles>
    <Style Selector="UserControl.narrow Grid.pad">
      <Setter Property="Margin" Value="8" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Tr Key=Dialog.ExitConfirm}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Classes="pad" Margin="16" RowDefinitions="*,Auto" RowSpacing="18">
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
          <TextBlock Text="{loc:Tr Key=Exit.Hint}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <Button Grid.Column="1" Content="{loc:Tr Key=Button.Cancel}" Click="OnCancel" />
          <Button Grid.Column="2" Content="{loc:Tr Key=Exit.SaveAndExit}"
                  Click="OnSaveAndExit" Classes="accent" />
          <Button Grid.Column="3" Content="{loc:Tr Key=Exit.ExitWithoutSave}"
                  Click="OnExitWithoutSave" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
