<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Melotag.UI.Localization"
              x:Class="Melotag.UI.Dialogs.TagSearchDialog">

  <UserControl.Styles>
    <Style Selector="UserControl.narrow Grid.pad">
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="UserControl.narrow StackPanel.ctl">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="170" />
    </Style>
    <Style Selector="UserControl.narrow ComboBox.ctl">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Tr Key=Dialog.TagSearch}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Classes="pad" Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

        <Border Grid.Row="0" Classes="card">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Classes="section" Text="{loc:Tr Key=Search.Conditions}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="fieldLabel" Text="{loc:Tr Key=Field.Title}" />
                <TextBox x:Name="TitleBox" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="fieldLabel" Text="{loc:Tr Key=Field.Artist}" />
                <TextBox x:Name="ArtistBox" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="fieldLabel" Text="{loc:Tr Key=Field.Album}" />
                <TextBox x:Name="AlbumBox" />
              </StackPanel>
              <Button Grid.Column="3" Content="{loc:Tr Key=Button.Search}" Click="OnSearch"
                      Classes="accent" VerticalAlignment="Bottom" MinWidth="96" Height="34" />
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Classes="fieldLabel" Text="{loc:Tr Key=Field.Source}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="SourceFilterBox" Classes="ctl" Width="220"
                    SelectionChanged="OnSourceFilterChanged" />
          <TextBlock Grid.Column="2" x:Name="Status" VerticalAlignment="Center"
                     Opacity="0.7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.Column="3" x:Name="Progress" IsIndeterminate="True" Width="110"
                       IsVisible="False" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="0">
          <Grid>
            <ListBox x:Name="ResultsList" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" Padding="6">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="6,4">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                 FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Meta}" FontSize="12" Opacity="0.65"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                      <TextBlock Text="{Binding SourceLabel}" FontSize="12" Opacity="0.65"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" Text="{loc:Tr Key=Search.EmptyHint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.5" FontSize="13" TextWrapping="Wrap"
                       IsHitTestVisible="False" />
          </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{loc:Tr Key=AutoMatch.Rule}" VerticalAlignment="Center" Classes="hint" />
          <ComboBox Grid.Column="1" x:Name="RuleCombo" Classes="ctl" Width="190" />
          <Button Grid.Column="3" Content="{loc:Tr Key=Button.Apply}" Click="OnApply" Classes="accent" />
          <Button Grid.Column="4" Content="{loc:Tr Key=Button.Cancel}" Click="OnCancel" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
