<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melotag.UI.Dialogs.TagSearchDialog">

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="在线标签匹配" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <WrapPanel Grid.Row="0">
          <StackPanel Spacing="4" Margin="0,0,10,6" Width="180">
            <TextBlock Text="标题" FontSize="12" Opacity="0.7" />
            <TextBox x:Name="TitleBox" />
          </StackPanel>
          <StackPanel Spacing="4" Margin="0,0,10,6" Width="180">
            <TextBlock Text="艺术家" FontSize="12" Opacity="0.7" />
            <TextBox x:Name="ArtistBox" />
          </StackPanel>
          <StackPanel Spacing="4" Margin="0,0,10,6" Width="180">
            <TextBlock Text="专辑" FontSize="12" Opacity="0.7" />
            <TextBox x:Name="AlbumBox" />
          </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
          <Button Content="搜索" Click="OnSearch" Classes="accent" />
          <ProgressBar x:Name="Progress" IsIndeterminate="True" Width="120" IsVisible="False" />
          <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="ResultsList" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="0,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Artist}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Album}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Year}" />
                  <Run Text=" · " />
                  <Run Text="{Binding SourceId}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="合并方式" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="RuleCombo" Width="190" HorizontalAlignment="Left" />
          <Button Grid.Column="2" Content="应用" Click="OnApply" Classes="accent" />
          <Button Grid.Column="3" Content="取消" Click="OnCancel" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
