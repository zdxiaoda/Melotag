<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Melotag.UI.Controls"
             x:Class="Melotag.UI.Dialogs.SettingsDialog">

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16" RowDefinitions="*,Auto" RowSpacing="10">
        <ScrollViewer Grid.Row="0">
          <StackPanel Spacing="16">

            <StackPanel Spacing="6">
              <TextBlock Text="搜索" FontWeight="SemiBold" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="并发线程" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="ThreadsBox" Width="110" Minimum="1" Maximum="8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="每源结果上限" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="ItemsBox" Width="110" Minimum="1" Maximum="50" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="自动匹配线程" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="AutoThreadsBox" Width="110" Minimum="1" Maximum="8" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="在线源" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Last.fm API Key" VerticalAlignment="Center" Width="130" />
                <TextBox x:Name="LastFmKeyBox" Width="300" PasswordChar="*" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="iTunes 国家码" VerticalAlignment="Center" Width="130" />
                <TextBox x:Name="CountryBox" Width="110" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="User-Agent" VerticalAlignment="Center" Width="130" />
                <TextBox x:Name="UserAgentBox" Width="380" />
              </StackPanel>
              <TextBlock Text="MusicBrainz 需要可识别的 User-Agent，并限制 1 次/秒；留空 Last.fm Key 则跳过该源。"
                         FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

              <TextBlock Text="启用与顺序（每类单独配置，越靠上越先查询）"
                         FontWeight="SemiBold" Margin="0,12,0,2" />
              <TabControl x:Name="SourceTabs" Height="380">
                <TabItem Header="标签">
                  <c:SourceOrderPanel x:Name="TagSources" Capability="Tags" Margin="2,8,2,2" />
                </TabItem>
                <TabItem Header="封面">
                  <c:SourceOrderPanel x:Name="CoverSources" Capability="Cover" Margin="2,8,2,2" />
                </TabItem>
                <TabItem Header="歌词">
                  <c:SourceOrderPanel x:Name="LyricSources" Capability="Lyrics" Margin="2,8,2,2" />
                </TabItem>
              </TabControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="歌词" FontWeight="SemiBold" />
              <WrapPanel>
                <CheckBox x:Name="ReformatBox" Content="下载后重排时间标签" Margin="0,0,16,0" />
                <CheckBox x:Name="RemoveTagsBox" Content="移除时间标签" Margin="0,0,16,0" />
                <CheckBox x:Name="BlankBox" Content="删除空行" Margin="0,0,16,0" />
                <CheckBox x:Name="HeadBox" Content="删除头部标签" Margin="0,0,16,0" />
                <CheckBox x:Name="InstrumentBox" Content="跳过伴奏/纯音乐" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="默认编码" VerticalAlignment="Center" Width="130" />
                <ComboBox x:Name="EncodingBox" Width="140" />
                <TextBlock Text="保存目录" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBox x:Name="SaveDirBox" Width="240" Watermark="留空=音频同目录" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="文件名格式" VerticalAlignment="Center" Width="130" />
                <TextBox x:Name="LrcNameBox" Width="220" Watermark="{}{title}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="封面" FontWeight="SemiBold" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="体积上限(KB)" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="PicSizeBox" Width="110" Minimum="64" Maximum="10240" Increment="64" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="最大宽" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="PicWidthBox" Width="100" Minimum="200" Maximum="6000" Increment="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="最大高" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="PicHeightBox" Width="100" Minimum="200" Maximum="6000" Increment="100" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="允许格式：jpg, png（BMP/GIF 会被转码）" FontSize="11" Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="写入" FontWeight="SemiBold" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                  <TextBlock Text="ID3v2 版本" VerticalAlignment="Center" />
                  <ComboBox x:Name="Id3Box" Width="110" />
                </StackPanel>
                <CheckBox x:Name="KeepMtimeBox" Content="保留文件修改时间" Margin="0,0,16,6" />
                <CheckBox x:Name="WriteLyricsBox" Content="歌词写入标签" Margin="0,0,16,6" />
              </WrapPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="界面" FontWeight="SemiBold" />
              <CheckBox x:Name="CompactBox" Content="紧凑行高" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Message" Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="保存" Click="OnSave" Classes="accent" />
          <Button Grid.Column="2" Content="取消" Click="OnCancel" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
