<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Melotag.UI.Controls"
             xmlns:loc="using:Melotag.UI.Localization"
             x:Class="Melotag.UI.Dialogs.SettingsDialog">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.settingRow">
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.settingLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="14,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Tr Key=Dialog.Settings}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="12" RowDefinitions="*,Auto" RowSpacing="10">
        <TabControl Grid.Row="0" Padding="0" TabStripPlacement="Left">

          <!-- 搜索 -->
          <TabItem Header="{loc:Tr Key=Settings.Search}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="hint" Text="{loc:Tr Key=Settings.SearchHint}" />
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.Threads}" />
                      <NumericUpDown x:Name="ThreadsBox" Minimum="1" Maximum="8"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.ItemsPerSource}" />
                      <NumericUpDown x:Name="ItemsBox" Minimum="1" Maximum="50"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.AutoMatchThreads}" />
                      <NumericUpDown x:Name="AutoThreadsBox" Minimum="1" Maximum="8"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 在线源 -->
          <TabItem Header="{loc:Tr Key=Settings.Sources}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.Connection}" />
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.LastFmKey}" />
                      <TextBox x:Name="LastFmKeyBox" PasswordChar="*"
                               HorizontalAlignment="Stretch" MaxWidth="380" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.ITunesCountry}" />
                      <ComboBox x:Name="CountryBox" HorizontalAlignment="Stretch" MaxWidth="300">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.UserAgent}" />
                      <TextBox x:Name="UserAgentBox" HorizontalAlignment="Stretch" MaxWidth="380" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{loc:Tr Key=Settings.UserAgentHint}" />
                    <TextBlock Classes="hint" Text="{loc:Tr Key=Settings.MusicBrainzNote}" />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.SourceOrder}" />
                    <TabControl x:Name="SourceTabs" Height="280">
                      <TabItem Header="{loc:Tr Key=Settings.TabTags}">
                        <c:SourceOrderPanel x:Name="TagSources" Capability="Tags" Margin="2,8,2,2" />
                      </TabItem>
                      <TabItem Header="{loc:Tr Key=Settings.TabCovers}">
                        <c:SourceOrderPanel x:Name="CoverSources" Capability="Cover" Margin="2,8,2,2" />
                      </TabItem>
                      <TabItem Header="{loc:Tr Key=Settings.TabLyrics}">
                        <c:SourceOrderPanel x:Name="LyricSources" Capability="Lyrics" Margin="2,8,2,2" />
                      </TabItem>
                    </TabControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 歌词 -->
          <TabItem Header="{loc:Tr Key=Settings.Lyrics}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.LyricsOptions}" />
                    <WrapPanel>
                      <CheckBox x:Name="ReformatBox" Content="{loc:Tr Key=Settings.ReformatAfterDownload}" Margin="0,0,20,8" />
                      <CheckBox x:Name="RemoveTagsBox" Content="{loc:Tr Key=Settings.RemoveTimeTags}" Margin="0,0,20,8" />
                      <CheckBox x:Name="BlankBox" Content="{loc:Tr Key=Settings.DeleteBlankLines}" Margin="0,0,20,8" />
                      <CheckBox x:Name="HeadBox" Content="{loc:Tr Key=Settings.DeleteHeadTags}" Margin="0,0,20,8" />
                      <CheckBox x:Name="InstrumentBox" Content="{loc:Tr Key=Settings.SkipInstrumental}" Margin="0,0,20,8" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.LyricsSaving}" />
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.DefaultEncoding}" />
                      <ComboBox x:Name="EncodingBox" HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.SaveDirectory}" />
                      <TextBox x:Name="SaveDirBox" HorizontalAlignment="Stretch" MaxWidth="380"
                               PlaceholderText="{loc:Tr Key=Settings.SaveDirectoryWatermark}" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.LrcFileNameFormat}" />
                      <TextBox x:Name="LrcNameBox" HorizontalAlignment="Stretch" MaxWidth="240" PlaceholderText="{}{title}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 封面 -->
          <TabItem Header="{loc:Tr Key=Settings.Covers}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.PictureLimits}" />
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.MaxSizeKb}" />
                      <NumericUpDown x:Name="PicSizeBox" Minimum="64" Maximum="10240" Increment="64"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.MaxWidth}" />
                      <NumericUpDown x:Name="PicWidthBox" Minimum="200" Maximum="6000" Increment="100"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.MaxHeight}" />
                      <NumericUpDown x:Name="PicHeightBox" Minimum="200" Maximum="6000" Increment="100"
                                     HorizontalAlignment="Stretch" MaxWidth="200" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{loc:Tr Key=Settings.CoverFormats}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 写入 -->
          <TabItem Header="{loc:Tr Key=Settings.Writing}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.Id3Version}" />
                      <ComboBox x:Name="Id3Box" HorizontalAlignment="Stretch" MaxWidth="160" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                      <CheckBox x:Name="KeepMtimeBox" Content="{loc:Tr Key=Settings.KeepMtime}" />
                      <CheckBox x:Name="WriteLyricsBox" Content="{loc:Tr Key=Settings.WriteLyrics}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- 界面 -->
          <TabItem Header="{loc:Tr Key=Settings.Ui}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="4,10,4,4" Spacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.UiAppearance}" />
                    <StackPanel Classes="settingRow">
                      <TextBlock Classes="settingLabel" Text="{loc:Tr Key=Settings.Language}" />
                      <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" MaxWidth="220">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="CompactBox" Content="{loc:Tr Key=Settings.CompactRows}" />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="{loc:Tr Key=Settings.Updates}" />
                    <CheckBox x:Name="CheckUpdatesBox" Content="{loc:Tr Key=Settings.CheckUpdates}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

        </TabControl>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Message" Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="{loc:Tr Key=Button.Save}" Click="OnSave" Classes="accent" />
          <Button Grid.Column="2" Content="{loc:Tr Key=Button.Cancel}" Click="OnCancel" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
