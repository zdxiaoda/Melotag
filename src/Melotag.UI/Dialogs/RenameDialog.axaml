<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Melotag.UI.Dialogs.RenameDialog"
        Title="重命名 / 文件名相关"
        Width="780" Height="640"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <RadioButton x:Name="ModeRename" Content="按标签重命名文件" IsChecked="True" IsCheckedChanged="OnModeChanged" />
        <RadioButton x:Name="ModeParse" Content="按文件名写回标签" IsCheckedChanged="OnModeChanged" />
      </StackPanel>

      <StackPanel x:Name="PanelRename" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="预制模板" VerticalAlignment="Center" />
          <ComboBox x:Name="PresetCombo" Width="240" SelectionChanged="OnPresetChanged" />
        </StackPanel>
        <TextBox x:Name="PatternBox" Watermark="例如 @5. @1 - @2（@0 不使用，@1 标题 … @8 专辑艺术家）"
                 TextChanged="OnPatternChanged" />
        <StackPanel Orientation="Horizontal" Spacing="18">
          <CheckBox x:Name="AlsoLrc" Content="同时重命名 .lrc" IsChecked="True" />
          <CheckBox x:Name="AlsoPic" Content="同时重命名封面文件" IsChecked="True" />
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="PanelParse" Spacing="8" IsVisible="False">
        <TextBox x:Name="RegexBox" Watermark="正则，例如 ^(\d+)\. (.+) - (.+)$" TextChanged="OnPatternChanged" />
        <TextBlock Text="捕获组映射" FontSize="12" Opacity="0.7" />
        <WrapPanel x:Name="GroupRows" />
      </StackPanel>
    </StackPanel>

    <DataGrid Grid.Row="1"
              x:Name="PreviewGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              RowHeight="28">
      <DataGrid.Columns>
        <DataGridTextColumn Header="原文件" Binding="{Binding Source}" Width="2*" />
        <DataGridTextColumn Header="结果" Binding="{Binding Target}" Width="2*" />
        <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="Message" Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="应用" Click="OnApply" Margin="8,0" Classes="accent" />
      <Button Grid.Column="2" Content="取消" Click="OnCancel" />
    </Grid>
  </Grid>
</Window>
