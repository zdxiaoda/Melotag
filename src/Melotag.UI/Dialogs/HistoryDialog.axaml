<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Melotag.UI.Dialogs.HistoryDialog"
        Title="标签历史"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <TextBlock Grid.Row="0" x:Name="Header" FontWeight="SemiBold" TextWrapping="Wrap" />

    <DataGrid Grid.Row="1"
              x:Name="HistoryGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              GridLinesVisibility="Horizontal"
              RowHeight="28">
      <DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="170" />
        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
        <DataGridTextColumn Header="艺术家" Binding="{Binding Artist}" Width="1.5*" />
        <DataGridTextColumn Header="专辑" Binding="{Binding Album}" Width="1.5*" />
        <DataGridTextColumn Header="序列号" Binding="{Binding Serial}" Width="230" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBlock x:Name="Status" Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" />
      <Button Grid.Column="1" Content="恢复选中" Click="OnRestore" Margin="8,0" Classes="accent" />
      <Button Grid.Column="2" Content="清空全部历史" Click="OnClear" Margin="8,0" />
      <Button Grid.Column="3" Content="关闭" Click="OnClose" />
    </Grid>
  </Grid>
</Window>
