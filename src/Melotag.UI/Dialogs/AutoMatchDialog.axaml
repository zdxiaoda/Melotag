<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Melotag.UI.Controls"
             xmlns:loc="using:Melotag.UI.Localization"
             x:Class="Melotag.UI.Dialogs.AutoMatchDialog">

  <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Tr Key=Dialog.AutoMatch}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCancel" Width="36" Height="30" Padding="0"
                  Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" x:Name="FileCountText" Opacity="0.75" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock Text="{loc:Tr Key=AutoMatch.Fields}" FontWeight="SemiBold" />
          <WrapPanel>
            <CheckBox x:Name="TitleCheck" Content="{loc:Tr Key=Field.Title}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="ArtistCheck" Content="{loc:Tr Key=Field.Artist}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="AlbumCheck" Content="{loc:Tr Key=Field.Album}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="AlbumArtistCheck" Content="{loc:Tr Key=Field.AlbumArtist}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="YearCheck" Content="{loc:Tr Key=Field.Year}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="TrackCheck" Content="{loc:Tr Key=Field.Track}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="DiscCheck" Content="{loc:Tr Key=Field.Disc}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="GenreCheck" Content="{loc:Tr Key=Field.Genre}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="CommentCheck" Content="{loc:Tr Key=Field.Comment}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="ComposerCheck" Content="{loc:Tr Key=Field.Composer}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="LyricsCheck" Content="{loc:Tr Key=Field.Lyrics}" IsChecked="True" Margin="0,0,20,4" />
            <CheckBox x:Name="CoverCheck" Content="{loc:Tr Key=Field.Cover}" IsChecked="True" Margin="0,0,20,4" />
          </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:Tr Key=AutoMatch.Rule}" VerticalAlignment="Center" />
          <ComboBox x:Name="RuleCombo" Width="190" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{loc:Tr Key=AutoMatch.Sources}" FontWeight="SemiBold" />

        <Border Grid.Row="4"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
          <c:SourceOrderPanel x:Name="TagSources" Capability="Tags" Margin="8" />
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="Message" Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="{loc:Tr Key=Button.Start}" Click="OnStart" Classes="accent" />
          <Button Grid.Column="2" Content="{loc:Tr Key=Button.Cancel}" Click="OnCancel" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
