<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:favl="using:FluentAvalonia.Styling"
             x:Class="Melotag.UI.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <favl:FluentAvaloniaTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- 所有窗口（含对话框）默认带品牌图标 -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://Melotag.UI/Assets/melotag-logo.png" />
    </Style>

    <!-- 对话框共用卡片/字段样式，避免每个页面各写一份、观感不一致 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>
</Application>
