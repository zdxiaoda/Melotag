<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:favl="using:FluentAvalonia.Styling"
             x:Class="Melotag.UI.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <favl:FluentAvaloniaTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- 所有窗口（含对话框）默认带品牌图标 -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://Melotag.UI/Assets/melotag-logo.png" />
    </Style>
  </Application.Styles>
</Application>
